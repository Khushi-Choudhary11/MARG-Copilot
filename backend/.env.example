# Optional: enables the Claude-powered AI controller assistant (/api/ai/ask).
# Without it, the backend falls back to a deterministic template answer, and
# the frontend additionally tries client-side puter.js as a richer fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5183

# Simulation tuning (optional).
DEMO_DATE=2026-06-10
SIM_SPEED=180
TWIN_BROADCAST_INTERVAL=3

# Optional master dataset override. The app ships with a small (~350KB)
# demo-day extract at data/processed/demo_day_master_data.csv which is
# committed to git and used by default - no override needed for normal
# deployments. Only set this to point at a larger/different dataset (a direct
# CSV URL, e.g. a "Publish to web -> CSV" Google Sheets link, NOT an /edit
# link - /edit URLs return HTML and will break startup).
MASTER_DATA_URL=
